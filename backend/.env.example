# Modèle de configuration — copier en `.env` et remplir.
#
#   cp .env.example .env
#
# Ce fichier est versionné et ne doit contenir AUCUNE valeur réelle.
# Le vrai `.env` est gitignoré (.gitignore:18) et ne doit jamais être commité.

# ============================================
# BASE DE DONNÉES
# ============================================
# Driver pg8000 (pas psycopg2). PostGIS est requis :
#   CREATE EXTENSION IF NOT EXISTS postgis;
DATABASE_URL=postgresql+pg8000://utilisateur:motdepasse@localhost:5432/MorchidHub

# ============================================
# SÉCURITÉ
# ============================================
# Générer une valeur aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# L'application REFUSE de démarrer si la clé fait moins de 32 caractères ou si
# c'est un exemple connu (voir _assert_secret_key_is_safe dans app/main.py) :
# une clé faible laisse forger un JWT valide pour n'importe quel compte,
# administrateur compris.
SECRET_KEY=

ALGORITHM=HS256

# Durée de vie des tokens d'accès, en minutes. Laisser commenté : la valeur
# vient alors de config.py (10080 = 7 jours) et ne peut pas diverger du code.
# Les tokens sont révocables en incrémentant users.token_version.
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# SERVEUR
# ============================================
HOST=0.0.0.0
PORT=8000

# DEBUG active uniquement le rechargement automatique d'uvicorn
# (app/main.py, bloc __main__). True en développement, False en déploiement.
DEBUG=False

# ============================================
# CORS
# ============================================
# Liste d'origines séparées par des virgules. Une origine absente d'ici est
# refusée : le middleware lit settings.cors_origins_list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# ADMINISTRATION
# ============================================
# Liste blanche des emails administrateurs, séparés par des virgules.
# C'est la SEULE autorité d'administration (app/api/deps.py:require_admin) :
# ni la colonne users.is_admin ni le rôle `administrator` n'accordent l'accès.
# Vide = aucun administrateur (échec fermé).
ADMIN_EMAILS=
