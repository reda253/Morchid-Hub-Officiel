# Variables de la topologie Docker Compose.
#
#   cp .env.example .env
#
# Ce fichier est versionné et ne doit contenir AUCUNE valeur réelle.
# Le vrai `.env` de la racine est gitignoré. À ne pas confondre avec
# `backend/.env`, qui sert au lancement hors Docker.

# ============================================
# BASE DE DONNÉES (service `db`)
# ============================================
POSTGRES_USER=morchid
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=morchid

# ============================================
# SÉCURITÉ (service `api`)
# ============================================
# L'application REFUSE de démarrer si la clé fait moins de 32 caractères ou si
# c'est un exemple connu. Générer une valeur :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ============================================
# API
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Liste blanche des administrateurs, séparée par des virgules.
# Vide = aucun administrateur (échec fermé).
ADMIN_EMAILS=
